# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — NOT used by the app at runtime; only for the one-time
# scripts/encrypt-existing-pii.mjs PII backfill. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for SSN / VA file number / banking data (32 bytes, hex-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key
# Retired keys to still DECRYPT with during/after a key rotation (comma-separated
# hex). Leave empty normally. To rotate: move the old ENCRYPTION_KEY here and set
# ENCRYPTION_KEY to a fresh key, redeploy, re-encrypt rows, then clear this.
ENCRYPTION_KEY_PREVIOUS=

# ── CAPTCHA (Cloudflare Turnstile) ──────────────────────────────────────────
# Bot/credential-stuffing protection on the login, signup, and password-reset
# forms. Leave BLANK to disable (the widget renders nothing and is a no-op).
# To enable: create a free Turnstile site at https://dash.cloudflare.com →
# Turnstile, put the SITE key here, and the SECRET key in the Supabase dashboard
# (Authentication → Settings → Bot & Abuse Protection → enable, Turnstile).
# Enable both together — turning on Supabase CAPTCHA without this key set will
# make every auth call fail.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
# Notifications use Resend when RESEND_API_KEY is set (recommended for prod —
# Gmail SMTP caps ~500/day and silently throttles). Otherwise they fall back to
# Gmail SMTP. EMAIL_FROM must be on a domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=Military Benefits Assistant <noreply@militarybenefitsassistant.com>
# Gmail SMTP fallback (used only when RESEND_API_KEY is empty):
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Demo mode (optional) ────────────────────────────────────────────────────
# When 'true', the login page shows one-click "Demo as User" / "Demo as Admin"
# buttons so prospective users can try the app without credentials.
# First seed the accounts: run supabase/seed_demo_accounts.sql in the SQL editor.
# ⚠ Only enable on a demo/staging project with NO real customer data — the admin
#   demo can view real agent-filing submissions.
NEXT_PUBLIC_ENABLE_DEMO=false
# Override only if you changed the emails/passwords in the seed script:
# NEXT_PUBLIC_DEMO_USER_EMAIL=demo.user@militarybenefitsassistant.com
# NEXT_PUBLIC_DEMO_USER_PASSWORD=DemoUser2026!
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=demo.admin@militarybenefitsassistant.com
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=DemoAdmin2026!
